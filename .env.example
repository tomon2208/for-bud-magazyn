# Skopiuj do .env.local (lokalnie) — nigdy nie commituj prawdziwych kluczy.
# UWAGA: OpenNext wkleja CAŁY .env.local do bundla Workera (.open-next/cloudflare/next-env.mjs).
# Trzymaj tu tylko zmienne potrzebne aplikacji. Hasła do bazy i konta admina → .env.scripts.
# Deploy NIE odbywa się z maszyny z .env.local (patrz docs/decisions/006-auth-roles.md).
# Wartości: Supabase → Project Settings → API Keys / Data API.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Tylko po stronie serwera (tworzenie użytkowników przez ADMIN). Nigdy z prefiksem NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...
