# Skopiuj do .env.scripts — zmienne TYLKO dla skryptów (db:push, admin:create, test:db).
# Ten plik nie jest czytany przez Next/OpenNext, więc nie trafia do bundla Workera. Nigdy nie commituj.

# Połączenie z bazą do migracji (Supabase CLI: db push). Supabase → Connect → Session pooler.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Pierwsze konto ADMIN — uzupełniane automatycznie przez `pnpm admin:create` (hasło losowe).
ADMIN_LOGIN=
ADMIN_PASSWORD=
